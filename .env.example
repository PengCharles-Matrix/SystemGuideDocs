MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=systemguidedocs
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PASSWORD_SALT=replace-with-a-different-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Set COOKIE_SECURE=true only when serving the site over HTTPS.
COOKIE_SECURE=false
